rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All user data lives under users/{userId}/
    // No user can read or write another user's data — ever.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Community templates ─────────────────────────────────────────────────
    // First multi-user data in PepMax. Templates are readable by all auth users.
    //
    // KNOWN VANDALISM RISK (MVP): The update rule only prevents changing
    // anonymousAuthorId — it does NOT restrict updates to the author.
    // Any authenticated user can update any template's content (title,
    // description, protocolData, status, etc.) as long as they preserve the
    // anonymousAuthorId field, which is publicly readable.
    // Server-side authorship enforcement requires Cloud Functions (Phase 5).
    // Track: https://github.com/your-org/pepmax/issues — template-vandalism

    match /templates/{templateId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
      allow update: if request.auth != null
        && resource.data.anonymousAuthorId == request.resource.data.anonymousAuthorId;
      // delete: admin only — via Firebase console or admin SDK

      match /reviews/{reviewId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
        allow update: if request.auth != null
          && resource.data.anonymousReviewerId == request.resource.data.anonymousReviewerId;
        // delete: admin only
      }
    }

    // Reports are write-only for users — only admin SDK can read.
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if false;
    }

    // bannedUsers: admin-managed. Users can check their own ban status.
    match /bannedUsers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Public Profiles ─────────────────────────────────────────────────────
    // Mirrors a subset of user profile data (e.g. avatar URL) for cross-user
    // reads. Any authenticated user can read; only the owner can write.
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── Active Beacons ──────────────────────────────────────────────────────
    // Keyed by shareToken (the doc ID IS the token — no query needed).
    // Clients write only their own beacons. No client reads — only the Cloud
    // Function (Admin SDK) reads this collection to serve the tracking page.
    match /activeBeacons/{tokenId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow read: if false;   // Admin SDK bypasses rules
      allow delete: if false; // Cleanup via scheduled Cloud Function
    }

    // ─── Compare scores (cross-user reads) ─────────────────────────────────────
    // Any authenticated user can read any user's aggregated compare scores.
    // Write is denied — only the computeCompareScores Cloud Function
    // (Admin SDK) can write these documents.
    match /userStats/{uid}/compareScores/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Route Segments ──────────────────────────────────────────────────────
    //
    // Segments are top-level docs at /segments/{segmentId}.
    // Efforts are a subcollection at /segments/{segmentId}/efforts/{uid}.
    //
    // Security notes:
    //   G1: Full resource paths use /databases/$(database)/documents/ prefix.
    //   G2: segmentCount null fallback prevents rule crash on first segment.
    //   G4: Effort updates are field-whitelisted to prevent tampering.
    //   G5: visibility enum is validated on create/update.

    match /segments/{segmentId} {
      // Any authenticated user can read public segments
      allow read: if request.auth != null
        && (resource.data.visibility == 'public'
          || resource.data.creatorUid == request.auth.uid);

      // Create: authenticated, not banned, creator field matches auth uid,
      // visibility is valid, and user has not exceeded their 20-segment quota.
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid))
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.visibility in ['public', 'private']
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.segmentCount == null
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.segmentCount < 20
        );

      // Update: split into two cases.
      //
      // (a) Creator can update any field except creatorUid; visibility must
      //     remain a valid enum; route is size-capped to match create rule.
      //
      // (b) Any authenticated user can update ONLY the bestEffort* fields and
      //     updatedAt — required when submitEffort writes a new course record
      //     and the submitter is not the segment creator.
      allow update: if request.auth != null
        && (
          // (a) Creator full update
          (resource.data.creatorUid == request.auth.uid
            && request.resource.data.creatorUid == resource.data.creatorUid
            && request.resource.data.visibility in ['public', 'private']
            && request.resource.data.route.size() <= 500)
          ||
          // (b) Any authenticated user may update only bestEffort fields
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['bestEffortUid', 'bestEffortSeconds', 'bestEffortUsername', 'updatedAt']))
        );

      // Delete: only the creator
      allow delete: if request.auth != null
        && resource.data.creatorUid == request.auth.uid;

      // ── Efforts subcollection ─────────────────────────────────────────────
      // Document ID must equal the authenticated user's UID.
      // Only the owner of an effort can create or update it.
      // Whitelisted fields on write to prevent score tampering.
      match /efforts/{effortUid} {
        // Any authenticated user can read efforts (for leaderboard display)
        allow read: if request.auth != null;

        // Create: effort doc ID must equal auth uid; required fields present
        allow create: if request.auth != null
          && effortUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasAll(['uid', 'displayName', 'durationSeconds', 'paceSecondsPerKm', 'sessionId', 'attemptedAt'])
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds > 0
          && request.resource.data.paceSecondsPerKm is number
          && request.resource.data.paceSecondsPerKm > 0;

        // Update: only allowed for the same user; whitelist updatable fields;
        // uid and sessionId are immutable after creation.
        allow update: if request.auth != null
          && effortUid == request.auth.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'durationSeconds', 'paceSecondsPerKm', 'sessionId', 'attemptedAt', 'createdAt', 'updatedAt'])
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds > 0;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
