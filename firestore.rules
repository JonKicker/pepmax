rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All user data lives under users/{userId}/
    // No user can read or write another user's data — ever.
    //
    // NOTE: waterLog is intentionally excluded from this wildcard so that its
    // own stricter match block (below) is the sole rule governing those paths.
    // Firestore uses OR semantics — a permissive wildcard would otherwise bypass
    // the waterLog field-level validation entirely.
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Deny writes to waterLog, seasonProgress, and eventProgress paths here
      // so their dedicated match blocks (below) are the sole rules governing
      // those paths.
      allow write: if request.auth != null && request.auth.uid == userId
        && !(request.path[4] == 'waterLog')
        && !(request.path[4] == 'seasonProgress')
        && !(request.path[4] == 'eventProgress')
        // personalGoalNote: max 100 chars (Ray's requirement).
        // The field is optional; when present it must be a string ≤ 100 chars.
        // Allow field deletion (null) and absent field.
        && (!request.resource.data.keys().hasAny(['personalGoalNote'])
          || request.resource.data.personalGoalNote == null
          || (request.resource.data.personalGoalNote is string
              && request.resource.data.personalGoalNote.size() <= 100))
        // RAY MANDATORY: novaGroup must be absent, null, or integer in [1,4].
        && (!request.resource.data.keys().hasAny(['novaGroup'])
          || request.resource.data.novaGroup == null
          || (request.resource.data.novaGroup is int
              && request.resource.data.novaGroup >= 1
              && request.resource.data.novaGroup <= 4))
        // RAY MANDATORY: fiber must be absent, null, or non-negative number <= 200.
        && (!request.resource.data.keys().hasAny(['fiber'])
          || request.resource.data.fiber == null
          || (request.resource.data.fiber is number
              && request.resource.data.fiber >= 0
              && request.resource.data.fiber <= 200))
        // RAY MANDATORY: nutritionScore must be absent, null, or a number in [0, 100].
        && (!request.resource.data.keys().hasAny(['nutritionScore'])
          || request.resource.data.nutritionScore == null
          || (request.resource.data.nutritionScore is number
              && request.resource.data.nutritionScore >= 0
              && request.resource.data.nutritionScore <= 100));
    }

    // ─── Hydration / Water Log ───────────────────────────────────────────────
    // Keyed by YYYY-MM-DD. totalOz is Firestore-maintained via increment().
    // Validates: totalOz is a number, >= 0, and <= 300; optional goalOz is
    // positive and <= 300.
    // This match is intentionally more specific than the wildcard above so it
    // takes precedence. The wildcard explicitly rejects waterLog writes to
    // prevent OR-semantics bypass.
    match /users/{userId}/waterLog/{date} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.totalOz is number
        && request.resource.data.totalOz >= 0
        && request.resource.data.totalOz <= 300
        && (!request.resource.data.keys().hasAny(['goalOz']) || (request.resource.data.goalOz is number && request.resource.data.goalOz > 0 && request.resource.data.goalOz <= 300));
    }

    // ─── Community templates ─────────────────────────────────────────────────
    // First multi-user data in PepMax. Templates are readable by all auth users.
    //
    // KNOWN VANDALISM RISK (MVP): The update rule only prevents changing
    // anonymousAuthorId — it does NOT restrict updates to the author.
    // Any authenticated user can update any template's content (title,
    // description, protocolData, status, etc.) as long as they preserve the
    // anonymousAuthorId field, which is publicly readable.
    // Server-side authorship enforcement requires Cloud Functions (Phase 5).
    // Track: https://github.com/your-org/pepmax/issues — template-vandalism

    match /templates/{templateId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
      allow update: if request.auth != null
        && resource.data.anonymousAuthorId == request.resource.data.anonymousAuthorId;
      // delete: admin only — via Firebase console or admin SDK

      match /reviews/{reviewId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid));
        allow update: if request.auth != null
          && resource.data.anonymousReviewerId == request.resource.data.anonymousReviewerId;
        // delete: admin only
      }
    }

    // Reports are write-only for users — only admin SDK can read.
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if false;
    }

    // bannedUsers: admin-managed. Users can check their own ban status.
    match /bannedUsers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Public Profiles ─────────────────────────────────────────────────────
    // Mirrors a subset of user profile data (e.g. avatar URL) for cross-user
    // reads. Any authenticated user can read; only the owner can write.
    //
    // instagramHandle validation: must be absent, null, or a string ≤ 30 chars.
    // The service layer enforces stricter format rules (alphanumeric + _ + .);
    // Firestore enforces the hard cap to prevent oversized writes.
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && (!request.resource.data.keys().hasAny(['instagramHandle'])
          || request.resource.data.instagramHandle == null
          || (request.resource.data.instagramHandle is string
              && request.resource.data.instagramHandle.size() <= 30));
    }

    // ─── Active Beacons ──────────────────────────────────────────────────────
    // Keyed by shareToken (the doc ID IS the token — no query needed).
    // Clients write only their own beacons. No client reads — only the Cloud
    // Function (Admin SDK) reads this collection to serve the tracking page.
    match /activeBeacons/{tokenId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow read: if false;   // Admin SDK bypasses rules
      allow delete: if false; // Cleanup via scheduled Cloud Function
    }

    // ─── PVP: Seasons (read-only for clients) ────────────────────────────────
    match /seasons/{seasonId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── PVP: Weekly Leagues (read-only for clients) ──────────────────────────
    match /weeklyLeagues/{leagueId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── PVP: User Season Progress (CF-only writes) ────────────────────────────
    // Excluded from the users wildcard write rule above.
    // Clients may read their own; writes are CF-only (Admin SDK bypasses rules).
    match /users/{userId}/seasonProgress/{seasonId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ─── PVP: RP Audit Log (CF-only writes) ────────────────────────────────────
    // Clients may read their own log entries; writes are CF-only.
    match /users/{userId}/rpLog/{logId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ─── Compare scores (cross-user reads) ─────────────────────────────────────
    // Any authenticated user can read any user's aggregated compare scores.
    // Write is denied — only the computeCompareScores Cloud Function
    // (Admin SDK) can write these documents.
    match /userStats/{uid}/compareScores/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── Route Segments ──────────────────────────────────────────────────────
    //
    // Segments are top-level docs at /segments/{segmentId}.
    // Efforts are a subcollection at /segments/{segmentId}/efforts/{uid}.
    //
    // Security notes:
    //   G1: Full resource paths use /databases/$(database)/documents/ prefix.
    //   G2: segmentCount null fallback prevents rule crash on first segment.
    //   G4: Effort updates are field-whitelisted to prevent tampering.
    //   G5: visibility enum is validated on create/update.

    match /segments/{segmentId} {
      // Any authenticated user can read public segments
      allow read: if request.auth != null
        && (resource.data.visibility == 'public'
          || resource.data.creatorUid == request.auth.uid);

      // Create: authenticated, not banned, creator field matches auth uid,
      // visibility is valid, and user has not exceeded their 20-segment quota.
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid))
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.visibility in ['public', 'private']
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.segmentCount == null
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.segmentCount < 20
        );

      // Update: split into two cases.
      //
      // (a) Creator can update any field except creatorUid; visibility must
      //     remain a valid enum; route is size-capped to match create rule.
      //
      // (b) Any authenticated user can update ONLY the bestEffort* fields and
      //     updatedAt — required when submitEffort writes a new course record
      //     and the submitter is not the segment creator.
      allow update: if request.auth != null
        && (
          // (a) Creator full update
          (resource.data.creatorUid == request.auth.uid
            && request.resource.data.creatorUid == resource.data.creatorUid
            && request.resource.data.visibility in ['public', 'private']
            && request.resource.data.route.size() <= 500)
          ||
          // (b) Any authenticated user may update only bestEffort fields
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['bestEffortUid', 'bestEffortSeconds', 'bestEffortUsername', 'updatedAt']))
        );

      // Delete: only the creator
      allow delete: if request.auth != null
        && resource.data.creatorUid == request.auth.uid;

      // ── Efforts subcollection ─────────────────────────────────────────────
      // Document ID must equal the authenticated user's UID.
      // Only the owner of an effort can create or update it.
      // Whitelisted fields on write to prevent score tampering.
      match /efforts/{effortUid} {
        // Any authenticated user can read efforts (for leaderboard display)
        allow read: if request.auth != null;

        // Create: effort doc ID must equal auth uid; required fields present
        allow create: if request.auth != null
          && effortUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasAll(['uid', 'displayName', 'durationSeconds', 'paceSecondsPerKm', 'sessionId', 'attemptedAt'])
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds > 0
          && request.resource.data.paceSecondsPerKm is number
          && request.resource.data.paceSecondsPerKm > 0;

        // Update: only allowed for the same user; whitelist updatable fields;
        // uid and sessionId are immutable after creation.
        allow update: if request.auth != null
          && effortUid == request.auth.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'durationSeconds', 'paceSecondsPerKm', 'sessionId', 'attemptedAt', 'createdAt', 'updatedAt'])
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds > 0;
      }
    }

    // ─── PVP Phase 3: Seasonal Events (read-only for clients, CF manages) ────
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── PVP Phase 3: Event progress (owner read, create-only join) ──────────
    // Client can only CREATE (join) with empty progress — cannot self-complete
    // challenges or claim badges. Updates (progress, completions, badge claims)
    // are CF-only via Admin SDK which bypasses these rules.
    // Excluded from the users wildcard write rule above.
    match /users/{userId}/eventProgress/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Client can only CREATE (join) with empty progress
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.challengeProgress == {}
        && request.resource.data.completedChallenges == []
        && request.resource.data.badgeClaimed == false;
      // Updates (progress, completions, badge claims) are CF-only via Admin SDK
      allow update: if false;
    }

    // ─── PVP Phase 3: Crew Challenges (read-only for clients) ────────────────
    match /crewChallenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── PVP Phase 3: Crew Challenge Entries (read-only, CF aggregates) ──────
    match /crewChallengeEntries/{entryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
