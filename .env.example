# Firebase config — copy this file to .env and fill in your values.
# .env is gitignored. Never commit real keys.
# Get these values from: Firebase Console → Project Settings → Your Apps

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Google OAuth Client IDs — from Firebase Console → Authentication → Sign-in method → Google
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# Mixpanel — from mixpanel.com → Project Settings → Project Token
EXPO_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here

# Sentry — from sentry.io → Project → Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# USDA FoodData Central — free key from https://fdc.nal.usda.gov/api-key-signup.html
EXPO_PUBLIC_USDA_API_KEY=your_usda_api_key_here
